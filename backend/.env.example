# Copie para .env e preencha com os valores do seu ambiente local.

# Servidor
PORT=3000

# Banco de dados MySQL
DB_HOST=seu_host_mysql
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_DATABASE=seu_banco_de_dados_mysql
DB_PORT=3306

# Authentication JWT
JWT_SECRET=COLOQUE_UM_SEGREDO_FORTE_AQUI
JWT_EXPIRES_IN=8h

# URL pública onde o frontend (index.html) está hospedado
FRONTEND_URL=http://localhost:5500

# SMTP para recuperação de senha e envio de relatórios PDF
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sensusgestao@gmail.com
SMTP_PASS=COLOQUE_A_SENHA_DE_APP_AQUI
SMTP_FROM=Sensus 5S <sensusgestao@gmail.com>

# Armazenamento de evidências - Cloudinary
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=sua_api_secret