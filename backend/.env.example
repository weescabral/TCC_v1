# Copie para .env e preencha com os valores do seu ambiente local.
PORT=3000
DB_HOST=localhost
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_DATABASE=sensus_db
DB_PORT=3306
JWT_SECRET=substitua_por_um_segredo_forte
JWT_EXPIRES_IN=8h

# URL pública onde o frontend (index.html) está hospedado
FRONTEND_URL=http://localhost:5500

# SMTP para envio do link de recuperação de senha
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@dominio.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=Sensus 5S <seu_email@dominio.com>
